{
  "name": "paperlight",
  "productName": "Paperlight",
  "version": "1.4.0",
  "description": "Paperlight - a lightweight, offline desktop PDF editor: view, edit, annotate, sign and save PDFs.",
  "main": "src/main/main.js",
  "author": "Paperlight",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:renderer\" \"npm run wait-and-electron\"",
    "wait-and-electron": "wait-on tcp:5173 && npm run dev:electron",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test": "npm run test:surgery && npm run test:search && npm run test:encryption && npm run test:fonts && npm run test:smoke",
    "test:surgery": "node scripts/text-surgery-test.mjs",
    "test:search": "node scripts/text-search-test.mjs",
    "test:encryption": "node scripts/verify-encryption.mjs",
    "test:fonts": "node scripts/fonts-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "^3.2.4",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "@signpdf/utils": "^3.2.4",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-rnd": "^10.4.13",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.paperlight.app",
    "productName": "Paperlight",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Paperlight"
    },
    "portable": {
      "artifactName": "Paperlight-Portable-${version}.exe"
    },
    "publish": null
  }
}
